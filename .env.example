# ==============================================================================
# WebVitals Web Security Intelligence — Unified Environment Configuration (.env.example)
# ==============================================================================

PORT=8888
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8888,http://localhost:3000

# Google Cloud Master API Key (Safe Browsing v4, PageSpeed Insights, Web Risk)
GOOGLE_API_KEY=your_google_cloud_api_key_here

# Google Gemini AI Key
AI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=20000
GEMINI_MAX_OUTPUT_TOKENS=4096

# VirusTotal Threat Intelligence API v3
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Scanner Concurrency & Storage
MAX_CONCURRENT_SCANS_PER_IP=3
MAX_TOTAL_CONCURRENT_SCANS=25
STORAGE_BACKEND=memory
MAX_HISTORY=100
